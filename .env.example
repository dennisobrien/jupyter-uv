# Copy to .env and fill in. .env is gitignored.
# Generate a token with: python3 -c "import secrets; print(secrets.token_hex(24))"
JUPYTER_TOKEN=changeme-generate-a-random-token

# Optional overrides (defaults shown).
# JUPYTER_PORT=8888
# JUPYTER_IP=127.0.0.1
# JUPYTER_NOTEBOOK_DIR=<parent directory of this repo>
# JUPYTER_STARTUP_TIMEOUT=60
